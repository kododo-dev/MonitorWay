<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MonitorWay.UI\MonitorWay.UI.csproj" />
        <ProjectReference Include="..\MonitorWay\MonitorWay.csproj" />
    </ItemGroup>

    <!--
      The MCP SDK depends on the 10.x Microsoft.Extensions.* packages on every target framework, so on net8.0 and
      net9.0 Logging has to follow Logging.Abstractions there: Logging 8.x next to Abstractions 10.x defines some
      types twice (ProviderAliasAttribute moved between them).
    -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging" VersionOverride="10.0.12" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalReiho)' != 'true'">
        <PackageReference Include="Kododo.Reiho.AspNetCore.Mcp" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalReiho)' == 'true'">
        <ProjectReference Include="$(ReihoSource)\Reiho.AspNetCore.Mcp\Reiho.AspNetCore.Mcp.csproj" />
    </ItemGroup>

    <PropertyGroup>
        <PackageId>Kododo.MonitorWay.Mcp</PackageId>
        <Description>Lets AI agents read the telemetry kept by MonitorWay over the Model Context Protocol: the overview of the HTTP endpoints, logs with search and context, traces with their spans, errors grouped with their occurrences, and metrics as time series.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/kododo-dev/MonitorWay</RepositoryUrl>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>logo.png</PackageIcon>
        <Version>2.0.0-preview</Version>
    </PropertyGroup>

    <ItemGroup>
        <None Include=".nuget\logo.png" Pack="true" PackagePath="\" />
        <None Include=".nuget\README.md" Pack="true" PackagePath="" />
    </ItemGroup>

</Project>
