<Project>
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>Latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>Kododo.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>Kododo.$(MSBuildProjectName)</RootNamespace>
    <PackageId>Kododo.$(MSBuildProjectName)</PackageId>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Kododo</Authors>
  </PropertyGroup>

  <!--
    Opt-in: -p:UseLocalReiho=true builds against the Reiho sources checked out next to this repository (../Reiho),
    e.g. to try Reiho changes before they are published. Without it the Reiho packages are used.
  -->
  <PropertyGroup>
    <ReihoSource Condition="'$(ReihoSource)' == ''">$(MSBuildThisFileDirectory)..\..\Reiho\src</ReihoSource>
  </PropertyGroup>

</Project>

